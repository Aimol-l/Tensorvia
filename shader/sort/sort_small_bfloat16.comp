#version 460

#extension GL_EXT_bfloat16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int outer;
    int n;
    int inner;
    int keep;
    int padded;      // 只有 block 路径用：n 补齐到的 2 的幂
    int descending;  // 1 = 降序（topk 的 largest）
} params;

layout(std430, binding = 0) buffer InputA {
    bfloat16_t data[];
} src;

layout(std430, binding = 1) buffer OutputVals {
    bfloat16_t data[];
} dstv;

layout(std430, binding = 2) buffer OutputIdx {
    int64_t data[];
} dsti;

// (值, 下标) 对：下标做次级键，天然稳定——平局时更靠前的下标在前，与 CPU 的
// std::stable_sort 语义一致（topk 的 largest/smallest 平局次序同理）。
struct Pair {
    bfloat16_t v;
    int   i;
};

// bfloat16_t 没有 == 运算符，比较前拓宽到 float（精确—— widening 不丢位）。
bool pair_before(bfloat16_t va, int ia, bfloat16_t vb, int ib, bool desc) {
    const float fa = float(va);
    const float fb = float(vb);
    if (fa == fb) return ia < ib;
    return desc ? (fb < fa) : (fa < fb);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    const int columns = params.outer * params.inner;
    if (int(idx) >= columns) return;
    const int o = int(idx) / params.inner;
    const int c = int(idx) % params.inner;
    const int base = (o * params.n) * params.inner + c;

    Pair pairs[32];
    for (int i = 0; i < params.n; ++i) {
        pairs[i].v = src.data[base + i * params.inner];
        pairs[i].i = i;
    }
    for (int i = 1; i < params.n; ++i) {
        const Pair cur = pairs[i];
        int j = i - 1;
        while (j >= 0 && pair_before(cur.v, cur.i, pairs[j].v, pairs[j].i,
                                     params.descending != 0)) {
            pairs[j + 1] = pairs[j];
            --j;
        }
        pairs[j + 1] = cur;
    }

    const int out_base = (o * params.keep) * params.inner + c;
    for (int i = 0; i < params.keep; ++i) {
        dstv.data[out_base + i * params.inner] = pairs[i].v;
        dsti.data[out_base + i * params.inner] = int64_t(pairs[i].i);
    }
}
