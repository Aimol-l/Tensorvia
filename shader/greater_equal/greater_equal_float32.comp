#version 460

// greater_equal 广播版：strides 解码

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int64_t numel;
    int ndim;
    int shape[8];
    int sa[8];
    int sb[8];
    int off_a;
    int off_b;
    int off_o;
} p;

layout(std430, binding = 0) readonly buffer InputA {
    float data[];
} a;

layout(std430, binding = 1) readonly buffer InputB {
    float data[];
} b;

layout(std430, binding = 2) writeonly buffer Output {
    int8_t data[];
} dst;
const float abs_tol = 1e-5;
const float rel_tol = 1e-6;

void main() {
    int64_t idx = int64_t(gl_GlobalInvocationID.x);
    if (idx >= p.numel) return;
    int64_t ia;
    int64_t ib;
    if (p.ndim == 0) {
        // 连续快路径（FR-4.2）：linearizable 布局下两侧 stride 恒为 1，下标即元素
        // 偏移——跳过每元素每操作数的 div/mod 解码。0 维 x 0 维也走这里（numel 1）。
        ia = idx + p.off_a;
        ib = idx + p.off_b;
    } else {
        // flat -> coord -> 双侧元素偏移（广播维 stride 为 0，off 为视图基偏移）
        ia = p.off_a;
        ib = p.off_b;
        int64_t tmp = idx;
        for (int d = p.ndim - 1; d >= 0; --d) {
            int64_t c = tmp % int64_t(p.shape[d]);
            tmp /= int64_t(p.shape[d]);
            ia += c * int64_t(p.sa[d]);
            ib += c * int64_t(p.sb[d]);
        }
    }

    float va = a.data[int(ia)];
    float vb = b.data[int(ib)];
    dst.data[int(idx) + p.off_o] = int8_t(va >= vb ? 1 : 0);
}
