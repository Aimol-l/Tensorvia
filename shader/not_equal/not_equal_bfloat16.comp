#version 460

// not_equal 广播版：strides 解码

#extension GL_EXT_bfloat16 : enable
#extension GL_EXT_shader_explicit_arithmetic : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int64_t numel;
    int ndim;
    int shape[8];
    int sa[8];
    int sb[8];
    int off_a;
    int off_b;
    int off_o;
} p;

layout(std430, binding = 0) readonly buffer InputA {
    bfloat16_t data[];
} a;

layout(std430, binding = 1) readonly buffer InputB {
    bfloat16_t data[];
} b;

layout(std430, binding = 2) writeonly buffer Output {
    int8_t data[];
} dst;
const float abs_tol = 1e-2;
const float rel_tol = 1e-2;

void main() {
    int64_t idx = int64_t(gl_GlobalInvocationID.x);
    if (idx >= p.numel) return;
    // flat -> coord -> 双侧元素偏移（广播维 stride 为 0，off 为视图基偏移）
    int64_t ia = p.off_a;
    int64_t ib = p.off_b;
    int64_t tmp = idx;
    for (int d = p.ndim - 1; d >= 0; --d) {
        int64_t c = tmp % int64_t(p.shape[d]);
        tmp /= int64_t(p.shape[d]);
        ia += c * int64_t(p.sa[d]);
        ib += c * int64_t(p.sb[d]);
    }

    float va = float(a.data[int(ia)]);
    float vb = float(b.data[int(ib)]);
    dst.data[int(idx) + p.off_o] = int8_t(!(abs(va - vb) <= max(rel_tol * max(abs(va), abs(vb)), abs_tol)) ? 1 : 0);
}
