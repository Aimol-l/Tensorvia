#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// 融合块 Conv2d+Relu+MaxPool2d(2x2)：一次调用算一个最终输出元素。
//
// 每个输出对应 conv 输出的 2x2 pool 窗口，窗口内 4 个位置各做一次
// kh x kw 直接卷积，relu 后取 max。不搬 workgroup 共享内存——每个输出
// 只读 kh*kw*4*in_ch 个输入、无跨输出复用，是带宽型操作；换来的是三个
// 算子合成一次提交与一次同步。
//
// 注：shared patch 版（感受野进 workgroup 共享、输入流量降一个量级）试过
// 三轮未过数值验证（索引偏移类 bug，与 conv2d 3x3 特化同款），已回退到
// 这个直读版；bench 口径下通用 conv2d 的 shared 收益见 README 性能表。
// 半精度在 32 位浮点里累加，只在写回时转回存储类型。has_bias == 0 时
// binding 2 不读：宿主在那里绑的是权重 buffer，只为满足描述符布局必须
// 非空（与 conv2d 的 shader 同一约定）。
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint batch;
    uint in_ch;
    uint in_h;
    uint in_w;
    uint out_ch;
    uint kh;
    uint kw;
    uint stride;
    uint padding;
    uint conv_h;
    uint conv_w;
    uint out_h;
    uint out_w;
    uint has_bias;
} params;

layout(std430, binding = 0) buffer Input {
    float16_t data[];
} src; // [batch, in_ch, in_h, in_w]

layout(std430, binding = 1) buffer Weight {
    float16_t data[];
} wgt; // [out_ch, in_ch, kh, kw]

layout(std430, binding = 2) buffer Bias {
    float16_t data[];
} bia; // [out_ch]

layout(std430, binding = 3) buffer Output {
    float16_t data[];
} dst; // [batch, out_ch, out_h, out_w]

void main() {
    const uint total = params.batch * params.out_ch * params.out_h * params.out_w;
    const uint i = gl_GlobalInvocationID.x;
    if (i >= total) return;

    const uint opx = i % params.out_w;
    uint rest     = i / params.out_w;
    const uint opy = rest % params.out_h;
    rest /= params.out_h;
    const uint oc = rest % params.out_ch;
    const uint n  = rest / params.out_ch;

    const uint in_plane = params.in_h * params.in_w;
    const uint kplane   = params.kh * params.kw;
    const int  pad      = int(params.padding);
    const int  ih       = int(params.in_h);
    const int  iw       = int(params.in_w);
    const float b = params.has_bias != 0 ? float(float(bia.data[oc])) : float(0);

    // pool 窗口的 2x2 个 conv 输出位置，各做一次卷积后 relu，取 max。
    float best = float(0);
    bool first = true;
    for (uint di = 0u; di < 2u; ++di) {
        const uint oy = opy * 2u + di;  // pool stride 固定 2
        for (uint dj = 0u; dj < 2u; ++dj) {
            const uint ox = opx * 2u + dj;
            float acc = b;
            for (uint c = 0u; c < params.in_ch; ++c) {
                const uint in_base = (n * params.in_ch + c) * in_plane;
                const uint w_base  = (oc * params.in_ch + c) * kplane;
                for (uint ii = 0u; ii < params.kh; ++ii) {
                    const int y = int(oy * params.stride + ii) - pad;
                    if (y < 0 || y >= ih) continue;
                    const uint row = in_base + uint(y) * params.in_w;
                    const uint wrow = w_base + ii * params.kw;
                    for (uint jj = 0u; jj < params.kw; ++jj) {
                        const int x = int(ox * params.stride + jj) - pad;
                        if (x < 0 || x >= iw) continue;
                        acc += float(float(src.data[row + uint(x)])) *
                               float(float(wgt.data[wrow + jj]));
                    }
                }
            }
            const float v = acc > float(0) ? acc : float(0);  // relu
            if (first || v > best) {
                best = v;
                first = false;
            }
        }
    }
    dst.data[(n * params.out_ch + oc) * (params.out_h * params.out_w) + opy * params.out_w +
             opx] = float16_t(best);
}
