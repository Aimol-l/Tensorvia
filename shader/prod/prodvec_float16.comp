#version 460
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable


layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int axis_dim;
    int outer_dim; // 输出总数（= outer*inner），派发边界
    int inner_dim;
    int numel;     // 输入的真实元素数；两趟归约的末段按它截断
} params;


layout(std430, binding = 0) buffer InputA {
    float16_t data[];
}src;

layout(std430, binding = 1) buffer OutputB {
    float data[];
}dst;

// 定义循环展开因子
const int UNROLL = 4;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (int64_t(idx) >= params.outer_dim) return;

    uint outer_idx = idx / params.inner_dim;
    uint inner_idx = idx % params.inner_dim;
    uint base_offset = outer_idx * params.inner_dim * params.axis_dim + inner_idx;
    // 轴循环按输入的真实元素数截断：两趟全归约的趟 1 末段会短于 axis_dim，不截断
    // 就会越界读。单趟路径下 numel == outer_dim*axis_dim，截断恒等，不改变结果。
    // numel 由宿主显式传入——不能在这里用 outer_dim*axis_dim 推导：趟 1 的几何是
    // (B, ceil(N/B), 1)，那个乘积含补位，会比真实元素数大。
    int numel = params.numel;
    int rem = numel - int(base_offset);
    int limit = params.axis_dim;
    if (rem < limit) limit = rem;

    // 空乘积为 1；整型在 int64 里累加（与 sum 家族的 reduction_type 一致）。
    float acc = float(1.0);
    // --- 主循环 (4-way 展开) ---
    uint i = 0;
    for(; i + (UNROLL - 1) < limit; i += UNROLL) {
        float prod_v = float(src.data[base_offset + i * params.inner_dim])
        * float(src.data[base_offset + (i + 1)* params.inner_dim])
        * float(src.data[base_offset + (i + 2)* params.inner_dim])
        * float(src.data[base_offset + (i + 3)* params.inner_dim]);
        acc *= prod_v;
    }

    for(; i < limit; ++i) {
        acc *= float(src.data[base_offset + i * params.inner_dim]);
    }

    dst.data[idx] = acc;
}
