#version 460

#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;


layout(push_constant) uniform Params {
    float min_v;
    float max_v;
    int64_t numel;
} params;

layout(std430, binding = 0) buffer InputA {
    int64_t data[];
}src;

layout(std430, binding = 1) buffer InputB {
    int64_t data[];
}dst;

// clamp 的判据与 include/core/numeric_contract.h 的 clamp_contract 同源（P-9 切片 3）。
// shader 读不到那份 C++ 代码，只能手工照抄——改契约时这八份要一起改。
//
// 两处与原实现不同：
//   ① **在元素自己的类型里钳，不经过 float**。原写法 `clamp(float(x), min_v, max_v)`
//      把 2^24 以上的整型先舍掉：`Clamp(int64 16777217, …)` 静默返回 16777216。
//      int8/int16 恰好安全（float 装得下它们全部取值），int32/int64 不安全，
//      但四份写法一致比"只修有问题的两份"更不容易在下次改动里再分叉。
//   ② **显式判 NaN 无关紧要**（整型没有 NaN），这条是为八份文件的写法统一而写：
//      浮点的另外四份必须显式判 NaN——GLSL 的 `min/max` 定义是"比较为假就返回 x"，
//      **规范上**本该传播 NaN；但**实测与规范相反**：把它们退回原写法重新构建后，
//      断言 NaN 传播的用例报红，本机驱动把它们编成了 FMin/FMax（IEEE maxNum 语义，
//      返回另一个操作数），NaN 照吞。这一层不能按规范推断，所以那四份写了判据。

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (int64_t(idx) >= params.numel) return;

    int64_t x  = src.data[idx];
    int64_t lo = int64_t(params.min_v);
    int64_t hi = int64_t(params.max_v);
    dst.data[idx] = (x < lo) ? lo : ((hi < x) ? hi : x);
}
