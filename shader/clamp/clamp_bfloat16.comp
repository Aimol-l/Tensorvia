#version 460

// 需要启动bfloat16扩展 和 int64扩展
#extension GL_EXT_bfloat16 : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    float min_v;
    float max_v;
    int64_t numel;
} params;


layout(std430, binding = 0) buffer InputA {
    bfloat16_t data[];
}src;

layout(std430, binding = 1) buffer InputB {
    bfloat16_t data[];
}dst;

// clamp 的判据与 include/core/numeric_contract.h 的 clamp_contract 同源（P-9 切片 3）。
// shader 读不到那份 C++ 代码，只能手工照抄——改契约时这八份要一起改。
//
// **显式判 NaN** 这一行不能省：不能靠 GLSL 的 `clamp`/`min`/`max`——它们的定义是
// "比较为假就返回 x"，**规范上**本该传播 NaN；但**实测与规范相反**——把它们退回原
// 写法重新构建后，断言 NaN 传播的用例报红，本机驱动把它们编成了 FMin/FMax
// （IEEE maxNum 语义，返回**另一个操作数**），NaN 照吞。修复前四个后端**一致地
// 吞** NaN、没有例外，所以这一层不能按规范推断。契约选的是传播
// （NumPy clip / PyTorch clamp 的语义）。
//
// 边界窄化到元素类型再比，与 C++ 三个后端一致；这一步本身**不可观测**——边界落在
// 相邻两个 T 值之间时，区间里没有第三个 T 值，而参与比较的 x 一定是 T 值。

// **bf16 这一份走 float 中转**，与其余七份"在元素自己的类型里比"的写法不同：
// glslang 的 bfloat16_t 只提供极少数运算符，`!=`、`<` 都不在其中
// （glslangValidator 报 `no operation '!=' exists that takes a left-hand operand
// of type 'bfloat16_t'`）。
//
// 中转在这里**不损失任何精度**：bfloat16 的尾数 8 位、指数 8 位，float 的尾数 24 位、
// 指数 8 位——float 能精确表示每一个 bfloat16 值，且比较结果与在 bf16 里比完全相同。
// 这与 float64/float32 那两份**恰好相反**：那两份走 float 中转会真的丢精度（CU-4），
// 所以它们必须留在自己的类型里。半精度 f16 的 `!=`/`<` 是可用的，无需中转。

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (int64_t(idx) >= params.numel) return;

    float x = float(src.data[idx]);
    if (x != x) {                       // NaN 传播（在 float 里判，见上）
        dst.data[idx] = src.data[idx];  // 原值回写，不经 float 转换
        return;
    }

    float lo = float(params.min_v);
    float hi = float(params.max_v);
    dst.data[idx] = bfloat16_t((x < lo) ? lo : ((hi < x) ? hi : x));
}
