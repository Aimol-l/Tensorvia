#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;


layout(push_constant) uniform Params {
    float min_v;
    float max_v;
    int64_t numel;
} params;

layout(std430, binding = 0) buffer InputA {
    double data[];
}src;

layout(std430, binding = 1) buffer InputB {
    double data[];
}dst;

// clamp 的判据与 include/core/numeric_contract.h 的 clamp_contract 同源（P-9 切片 3）。
// shader 读不到那份 C++ 代码，只能手工照抄——改契约时这八份要一起改。
//
// 写法上两处不能省：
//   ① **显式判 NaN**（第一行）。不能靠 GLSL 的 `clamp`/`min`/`max`——它们的定义是
//      "比较为假就返回 x"，**规范上**本该传播 NaN；但**实测与规范相反**——把它们退回原
//      写法重新构建后，断言 NaN 传播的用例报红，本机驱动把它们编成了 FMin/FMax
//      （IEEE maxNum 语义，返回**另一个操作数**），NaN 照吞。修复前四个后端**一致地
//      吞** NaN、没有例外，所以这一层不能按规范推断。契约选的是传播
//      （NumPy clip / PyTorch clamp 的语义）。
//   ② **改成三元比较**。这一条在**本文件（float64）上不是为了精度**——原写法
//      `clamp(src.data[idx], params.min_v, params.max_v)` 里 x 是 double、边界是
//      float，看着像窄化，实际不是：GLSL 的隐式转换只允许 float→double，**不允许
//      double→float**，故两个 float 边界被提升为 double，x 一位都没丢。用
//      glslangValidator 探针实测过这个方向：`clamp(double, float, float)` 编译通过，
//      而 `clamp(float, double, double)` 报 "cannot convert from double to float"。
//      改的理由是①——NaN 判据一旦显式写出，`clamp` 内建就用不上了，三元比较是
//      剩下的写法，顺带让八份 shader 在类型处理上一致。
//      **真正因窄化而失真的是 int32/int64 那两份**：`int(clamp(float(x), …))` 里的
//      `float(x)` 把 int 压到 24 位。本文件不在其列。

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (int64_t(idx) >= params.numel) return;

    double x = src.data[idx];
    if (x != x) { dst.data[idx] = x; return; }

    double lo = double(params.min_v);
    double hi = double(params.max_v);
    dst.data[idx] = (x < lo) ? lo : ((hi < x) ? hi : x);
}
