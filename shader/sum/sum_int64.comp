#version 460

#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;


layout(push_constant) uniform Params {
    int64_t numel;
} params;

layout(std430, binding = 0) buffer InputA {
    int64_t data[];
}src;

// binding 必须是 1：原先与 InputA 同为 0，两者在描述符集里是**同一块 buffer**，
// 于是 `dst.data[gl_WorkGroupID.x] = ...` 写回的是输入张量本身（破坏输入，
// 且由于 dst 落在 src 的前几个元素上，还会被网格步长循环重新读进去），
// 而真正的暂存区从未被写入 → 宿主折叠读到 0，Sum(INT64) 在 Vulkan 上恒为 0。
// 与 GLSL 同名的其它 sum_*.comp 都写 binding = 1，此处是唯一的例外。
layout(std430, binding = 1) buffer OutputB {
    int64_t data[];
}dst;

shared int64_t sharedMem[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint idx = gl_GlobalInvocationID.x;
    uint block_size = gl_WorkGroupSize.x;
    uint group_size = gl_NumWorkGroups.x * block_size;
    // grid stride
    int64_t sum = int64_t(0);
    for (uint s = idx; s < params.numel; s += group_size) {
        sum += src.data[s];
    }
    // block stride
    sharedMem[tid] = sum;
    barrier();
    for (uint stride = block_size / 2; stride > 32; stride >>= 1) {
        if (tid < stride) {
            sharedMem[tid] += sharedMem[tid + stride];
        }
        barrier();
    }
    #pragma unroll
    for(int i = 32; i > 0; i >>= 1) {
        if( tid < i) {
            sharedMem[tid] += sharedMem[tid + i];
        }
        barrier();
    }
    if (tid == 0) {
        dst.data[gl_WorkGroupID.x] = int64_t(sharedMem[0]);
    }

}
