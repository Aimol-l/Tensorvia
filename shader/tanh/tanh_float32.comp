#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int64_t numel;
} params;

layout(std430, binding = 0) buffer InputA {
    float data[];
} a;

layout(std430, binding = 1) buffer InputB {
    float data[];
} b;


void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (int64_t(idx) >= params.numel) return;

    // GLSL 内建 tanh 就是 GLSL.std.450 的 Tanh，两端都不会上溢/下溢，
    // 直接用它比自己拼指数更准也更省。
    // tanh(x) = (e^2x - 1) / (e^2x + 1)。原先写的是 exp(2x-1)/exp(2x+1)——
    // 分子分母各减 1，商恒等于 exp(-2)≈0.1353，与 x 完全无关（tanh(0) 也因此
    // 得到 0.1353 而不是 0）。这是本后端此前唯一的 tanh 实现，错得最彻底的一处。
    b.data[idx] = tanh(a.data[idx]);
}
