#version 460

// divvec 广播版：strides 解码，flat 为恒等 strides 特例

#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int64_t numel;
    int ndim;
    int shape[8];
    int sa[8];
    int sb[8];
    int off_a;
    int off_b;
    int off_o;
} p;

layout(std430, binding = 0) readonly buffer InputA {
    int64_t data[];
} a;

layout(std430, binding = 1) readonly buffer InputB {
    int64_t data[];
} b;

layout(std430, binding = 2) writeonly buffer Output {
    int64_t data[];
} outBuf;
void main() {
    int64_t idx = int64_t(gl_GlobalInvocationID.x);
    if (idx >= p.numel) return;
    // flat -> coord -> 双侧元素偏移（广播维 stride 为 0，off 为视图基偏移）
    int64_t ia = p.off_a;
    int64_t ib = p.off_b;
    int64_t tmp = idx;
    for (int d = p.ndim - 1; d >= 0; --d) {
        int64_t c = tmp % int64_t(p.shape[d]);
        tmp /= int64_t(p.shape[d]);
        ia += c * int64_t(p.sa[d]);
        ib += c * int64_t(p.sb[d]);
    }

    // 整型除零定义为 0（审计 B3）。
    outBuf.data[int(idx) + p.off_o] = (b.data[int(ib)] == 0) ? int64_t(0) : (a.data[int(ia)] / b.data[int(ib)]);
}
