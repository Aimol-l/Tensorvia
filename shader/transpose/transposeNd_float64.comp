#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int numel;
    int dims;
    int axes[8];        // axes[i] = 输出第 i 维对应的输入维
    int in_strides[8];  // 输入步长（行主序）
    int out_strides[8]; // 输出步长（行主序）
} params;

layout(std430, binding = 0) readonly buffer InputA {
    double data[];
} src;

layout(std430, binding = 1) writeonly buffer Output {
    double data[];
} dst;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (int(gid) >= params.numel) return;

    // 步骤 1：把输出线性下标分解为输出坐标
    uint temp = gid;
    uint input_idx = 0;

    // 步骤 2：对每个输出维 i 取出坐标并映射到输入
    for (int i = 0; i < params.dims; ++i) {
        // 沿输出维 i 的坐标
        uint coord = temp / uint(params.out_strides[i]);
        temp = temp % uint(params.out_strides[i]);

        // 该坐标来自输入维 `params.axes[i]`
        // 因此累加：coord * input_stride[对应的输入维]
        int input_dim = params.axes[i];
        input_idx += coord * uint(params.in_strides[input_dim]);
    }

    // 步骤 3：拷贝数据
    dst.data[gid] = src.data[input_idx];
}