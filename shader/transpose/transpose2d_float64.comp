#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define TILE 32

layout(local_size_x = TILE, local_size_y = TILE, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint rows;
    uint cols;
} params;

layout(std430, binding = 0) buffer InputA {
    double data[];
} src; // [rows][cols]

layout(std430, binding = 1) buffer Output {
    double data[];
} dst; // [cols][rows]

// 带填充的共享内存分块，用于避免 bank 冲突
shared double Tile[TILE][TILE + 1];

void main() {
    uint wg_x = gl_WorkGroupID.x; // 源中的块列索引
    uint wg_y = gl_WorkGroupID.y; // 源中的块行索引

    uint tx = gl_LocalInvocationID.x; // 块内线程列
    uint ty = gl_LocalInvocationID.y; // 块内线程行

    // 全局源下标
    uint global_src_row = wg_y * TILE + ty;
    uint global_src_col = wg_x * TILE + tx;

    // 从 src[row][col] 载入共享内存 Tile[ty][tx]
    if (global_src_row < params.rows && global_src_col < params.cols) {
        uint src_idx = global_src_row * params.cols + global_src_col;
        Tile[ty][tx] = src.data[src_idx];
    } else {
        Tile[ty][tx] = double(0); // 填充
    }

    // 同步：确保所有线程完成载入
    barrier();

    // 转置写出：线程 (tx, ty) 把 Tile[tx][ty] 写到 dst[col][row]
    uint global_dst_row = wg_x * TILE + ty; // = 原始列
    uint global_dst_col = wg_y * TILE + tx; // = 原始行

    if (global_dst_row < params.cols && global_dst_col < params.rows) {
        uint dst_idx = global_dst_row * params.rows + global_dst_col;
        dst.data[dst_idx] = Tile[tx][ty]; // 注意：[tx][ty] 而非 [ty][tx]
    }
}