#version 460

// cumsum：沿 axis 的累积和，输出与输入同形同 dtype。

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Params {
    int outer;
    int axis_len;
    int inner;
} p;

layout(std430, binding = 0) readonly buffer Input { int data[]; } src;

layout(std430, binding = 1) writeonly buffer Output { int data[]; } dst;

// 一个线程负责一条 (outer, inner) 柱，累积顺序与 CPU 内核一致。16 位浮点在
// float 里累加（与 sum/softmax 的着色器同一套做法），其余在自身类型里累加。
void main() {
    const int64_t total = int64_t(p.outer) * int64_t(p.inner);
    const int64_t task  = int64_t(gl_GlobalInvocationID.x);
    if (task >= total) return;
    const int64_t o    = task / int64_t(p.inner);
    const int64_t inn  = task % int64_t(p.inner);
    const int64_t step = int64_t(p.inner);
    const int64_t base = o * int64_t(p.axis_len) * step + inn;
    int64_t acc = int64_t(0);
    for (int64_t k = 0; k < int64_t(p.axis_len); ++k) {
        acc += int64_t(src.data[int(base + k * step)]);
        dst.data[int(base + k * step)] = int(acc);
    }
}
