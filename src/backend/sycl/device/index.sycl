#include "common.h"

using namespace tvv::sycl_dev;
namespace contract = tvv::sycl_dev::contract;

namespace {

// 索引只有 INT32/INT64 两种（公开入口已经拒绝其它 dtype）。
inline int64_t load_index(const void* p, int64_t i, int dtype) {
    if (dtype == tvv::sycl::kInt64) return static_cast<const int64_t*>(p)[i];
    return static_cast<const int32_t*>(p)[i];
}

// 越界索引截断到 0：调用方会读标志并抛异常，但即使没读，内核也不能越界读写。
inline int64_t clamp_index(int64_t v, int64_t axis_len, int32_t* flag) {
    if (v < 0 || v >= axis_len) {
        if (flag != nullptr) *flag = 1;
        return 0;
    }
    return v;
}

// 写出时把 BOOL 规范化为 0/1：源的字节可能是 2 之类的非规范值。
template <class T>
inline T normalize_store(T v) {
    if constexpr (std::is_same_v<T, uint8_t>) return v != 0 ? uint8_t{1} : uint8_t{0};
    else return v;
}

// 非零即真，按类型静态化（对应 cond_truth 的设备分支）。
template <class C>
inline bool is_nonzero(C v) {
    if constexpr (is_low_precision<C>::value) return load_as_float(v) != 0.0f;
    else return v != C(0);
}

// 通用路径：三侧形状相同、步长各异（含广播的 0 步长）。坐标只解码一次，三侧各自
// 点乘步长；旧写法对每一侧各跑一遍解码，每个元素要做三倍的 64 位除/模。
template <class T, class C>
void select_kernel(::sycl::queue& q, const C* cond, const T* a, const T* b, T* out,
                   const tvv::sycl::Select& p) {
    q.parallel_for(range_of(p.numel), [=](::sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        int64_t rem = i;
        int64_t oc = p.off_c;
        int64_t oa = p.off_a;
        int64_t ob = p.off_b;
        for (int d = p.ndim - 1; d >= 0; --d) {
            const int64_t dim = p.shape[d];
            if (dim <= 0) continue;
            const int64_t coord = rem % dim;
            rem /= dim;
            oc += coord * p.sc[d];
            oa += coord * p.sa[d];
            ob += coord * p.sb[d];
        }
        out[p.off_o + i] = normalize_store(is_nonzero<C>(cond[oc]) ? a[oa] : b[ob]);
    });
}

// 三侧都是连续行主序：偏移恒等于扁平下标。逐元素解码三组多维坐标是这里唯一的
// 开销来源（每个元素 6 次 64 位除/模），连续情形下它全是恒等运算。
inline bool select_side_contiguous(const tvv::sycl::Select& p, const int64_t* strides) {
    int64_t stride = 1;
    for (int d = p.ndim - 1; d >= 0; --d) {
        if (p.shape[d] <= 0) continue;
        if (strides[d] != stride) return false;
        stride *= p.shape[d];
    }
    return true;
}

template <class T, class C>
void select_contig_kernel(::sycl::queue& q, const C* cond, const T* a, const T* b,
                          T* out, const tvv::sycl::Select& p) {
    q.parallel_for(range_of(p.numel), [=](::sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        const bool pick_a = is_nonzero<C>(cond[p.off_c + i]);
        out[p.off_o + i] = normalize_store(pick_a ? a[p.off_a + i] : b[p.off_b + i]);
    });
}

// 一侧在全 0 步长下是“整侧一个值”（标量或整维广播）。
inline bool select_side_constant(const tvv::sycl::Select& p, const int64_t* strides) {
    for (int d = 0; d < p.ndim; ++d) {
        if (p.shape[d] > 0 && strides[d] != 0) return false;
    }
    return true;
}

// 每侧要么就是扁平下标（连续），要么是单个常量（全 0 步长）——零维标量参与的
// where 属于这一族。三个 kind 在整个网格上一致，不引入发散；相比通用路径省掉了
// 逐元素多维解码和随之而来的结构体动态下标访问。
template <class T, class C>
void select_linear_kernel(::sycl::queue& q, const C* cond, const T* a, const T* b,
                          T* out, const tvv::sycl::Select& p, int cond_lin,
                          int a_lin, int b_lin) {
    q.parallel_for(range_of(p.numel), [=](::sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        const bool pick_a =
            is_nonzero<C>(cond[p.off_c + (cond_lin ? i : int64_t{0})]);
        const int64_t oa = p.off_a + (a_lin ? i : int64_t{0});
        const int64_t ob = p.off_b + (b_lin ? i : int64_t{0});
        out[p.off_o + i] = normalize_store(pick_a ? a[oa] : b[ob]);
    });
}

// 输出元素 (o, k, inn) = 输入 (o, idx[k], inn)；按输出扁平下标一元素一项。
template <class T>
void index_select_kernel(::sycl::queue& q, const T* in, const void* idx, T* out,
                         const tvv::sycl::IndexAxis& p, int idx_dtype, int32_t* flag) {
    const int64_t total = p.outer * p.idx_len * p.inner;
    q.parallel_for(range_of(total), [=](::sycl::id<1> id) {
        const int64_t i = static_cast<int64_t>(id[0]);
        const int64_t inn = i % p.inner;
        const int64_t t   = i / p.inner;
        const int64_t k   = t % p.idx_len;
        const int64_t o   = t / p.idx_len;
        const int64_t r   = clamp_index(load_index(idx, k, idx_dtype), p.axis_len, flag);
        out[i] = in[(o * p.axis_len + r) * p.inner + inn];
    });
}

template <class T>
void gather_kernel(::sycl::queue& q, const T* in, const void* idx, T* out,
                   const tvv::sycl::Gather& p, int32_t* flag) {
    q.parallel_for(range_of(p.numel), [=](::sycl::id<1> id) {
        const int64_t i = static_cast<int64_t>(id[0]);
        // 扁平下标 -> 坐标；非 dim 维的坐标按输入步长累加成 base。
        int64_t base = 0;
        int64_t rem  = i;
        for (int d = p.ndim - 1; d >= 0; --d) {
            const int64_t dim = p.out_shape[d];
            if (dim <= 0) continue;
            const int64_t coord = rem % dim;
            rem /= dim;
            if (d != p.dim) base += coord * p.in_strides[d];
        }
        const int64_t r = clamp_index(load_index(idx, i, p.idx_dtype), p.axis_dim, flag);
        out[i] = in[base + r * p.axis_stride];
    });
}

// 一项负责一条 (outer, inner) 柱；累积顺序与 CPU 内核完全一致。
template <class T>
void cumsum_kernel(::sycl::queue& q, const T* in, T* out,
                   const tvv::sycl::IndexAxis& p) {
    const int64_t total = p.outer * p.inner;
    q.parallel_for(range_of(total), [=](::sycl::id<1> id) {
        const int64_t task = static_cast<int64_t>(id[0]);
        const int64_t o    = task / p.inner;
        const int64_t inn  = task % p.inner;
        const T* src = in + o * p.axis_len * p.inner + inn;
        T* dst       = out + o * p.axis_len * p.inner + inn;
        T acc = store_from_double<T>(0.0);
        for (int64_t k = 0; k < p.axis_len; ++k) {
            acc += src[k * p.inner];
            dst[k * p.inner] = acc;
        }
    });
}

}  // namespace

extern "C" {

int sycl_c_launch_select(void* ctx, const void* cond, const void* a, const void* b,
                         void* out, int out_dtype, const tvv::sycl::Select* p) {
    if (ctx == nullptr || cond == nullptr || a == nullptr || b == nullptr ||
        out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(out_dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            const bool c_lin = select_side_contiguous(*p, p->sc);
            const bool a_lin = select_side_contiguous(*p, p->sa);
            const bool b_lin = select_side_contiguous(*p, p->sb);
            if (c_lin && a_lin && b_lin) {
                return dispatch_dtype(p->cond_dtype, [&](auto cond_tag) -> int {
                    using C = typename decltype(cond_tag)::type;
                    select_contig_kernel<T, C>(q, static_cast<const C*>(cond),
                                               static_cast<const T*>(a),
                                               static_cast<const T*>(b),
                                               static_cast<T*>(out), *p);
                    return tvv::sycl::kSyclOk;
                });
            }
            const bool c_scalar = !c_lin && select_side_constant(*p, p->sc);
            const bool a_scalar = !a_lin && select_side_constant(*p, p->sa);
            const bool b_scalar = !b_lin && select_side_constant(*p, p->sb);
            if ((c_lin || c_scalar) && (a_lin || a_scalar) && (b_lin || b_scalar)) {
                return dispatch_dtype(p->cond_dtype, [&](auto cond_tag) -> int {
                    using C = typename decltype(cond_tag)::type;
                    select_linear_kernel<T, C>(
                        q, static_cast<const C*>(cond), static_cast<const T*>(a),
                        static_cast<const T*>(b), static_cast<T*>(out), *p,
                        c_lin ? 1 : 0, a_lin ? 1 : 0, b_lin ? 1 : 0);
                    return tvv::sycl::kSyclOk;
                });
            }
            return dispatch_dtype(p->cond_dtype, [&](auto cond_tag) -> int {
                using C = typename decltype(cond_tag)::type;
                select_kernel<T, C>(q, static_cast<const C*>(cond),
                                    static_cast<const T*>(a), static_cast<const T*>(b),
                                    static_cast<T*>(out), *p);
                return tvv::sycl::kSyclOk;
            });
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_index_select(void* ctx, const void* in, const void* idx, void* out,
                               int out_dtype, int idx_dtype, const tvv::sycl::IndexAxis* p,
                               int32_t* flag) {
    if (ctx == nullptr || in == nullptr || idx == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(out_dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            index_select_kernel<T>(q, static_cast<const T*>(in), idx,
                                   static_cast<T*>(out), *p, idx_dtype, flag);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_gather(void* ctx, const void* in, const void* idx, void* out,
                         int out_dtype, int idx_dtype, const tvv::sycl::Gather* p,
                         int32_t* flag) {
    if (ctx == nullptr || in == nullptr || idx == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(out_dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            gather_kernel<T>(q, static_cast<const T*>(in), idx, static_cast<T*>(out), *p,
                             flag);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_cumsum(void* ctx, const void* in, void* out, int dtype,
                         const tvv::sycl::IndexAxis* p) {
    if (ctx == nullptr || in == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            cumsum_kernel<T>(q, static_cast<const T*>(in), static_cast<T*>(out), *p);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

}  // extern "C"
