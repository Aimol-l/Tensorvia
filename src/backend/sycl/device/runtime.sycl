#include "common.h"

#include "_sync_counters.h"

#include <atomic>
#include <cstring>
#include <memory>
#include <mutex>
#include <unordered_map>
#include <vector>

using namespace tvv::sycl_dev;

namespace {

std::atomic<uint64_t> g_next_context_id{1};
thread_local std::unordered_map<uint64_t, ::sycl::queue*> tls_queue;
thread_local std::string t_last_error;
constexpr size_t kPoolMinBlock  = 512;              // 小请求按 512B 对齐，尺寸相近可复用
constexpr size_t kPoolMaxCached = size_t{256} << 20;  // 单 context 缓存上限，超出直接归还

struct BlockPool {
    std::mutex mtx;
    std::unordered_map<::sycl::queue*, std::unordered_map<size_t, std::vector<void*>>>
        free_blocks;
    std::unordered_map<void*, size_t> block_bytes;  // 活块 -> 对齐后的字节数
    size_t cached_bytes = 0;
};


std::mutex& pools_mutex() {
    static auto* m = new std::mutex;
    return *m;
}

std::unordered_map<uint64_t, std::shared_ptr<BlockPool>>& pools() {
    static auto* m = new std::unordered_map<uint64_t, std::shared_ptr<BlockPool>>;
    return *m;
}

inline size_t round_block(size_t bytes) {
    const size_t rounded = (bytes + kPoolMinBlock - 1) & ~(kPoolMinBlock - 1);
    return rounded == 0 ? kPoolMinBlock : rounded;
}

std::shared_ptr<BlockPool> pool_of(uint64_t context_id) {
    std::lock_guard<std::mutex> lock(pools_mutex());
    std::shared_ptr<BlockPool>& slot = pools()[context_id];
    if (!slot) slot = std::make_shared<BlockPool>();
    return slot;
}

void* pool_take(BlockPool& pool, ::sycl::queue& q, size_t bytes) {
    const size_t rounded = round_block(bytes);
    {
        std::lock_guard<std::mutex> lock(pool.mtx);
        auto bucket = pool.free_blocks.find(&q);
        if (bucket != pool.free_blocks.end()) {
            auto slot = bucket->second.find(rounded);
            if (slot != bucket->second.end() && !slot->second.empty()) {
                void* ptr = slot->second.back();
                slot->second.pop_back();
                pool.cached_bytes -= rounded;
                return ptr;
            }
        }
    }
    void* ptr = ::sycl::malloc_device(rounded, q);
    if (ptr != nullptr) {
        std::lock_guard<std::mutex> lock(pool.mtx);
        pool.block_bytes[ptr] = rounded;
    }
    return ptr;
}

// 把块收回缓存；超过上限就直接还给驱动。调用点保证块已不被任何 kernel 引用。
void pool_put(BlockPool& pool, ::sycl::queue& q, void* ptr) {
    size_t bytes = 0;
    {
        std::lock_guard<std::mutex> lock(pool.mtx);
        auto live = pool.block_bytes.find(ptr);
        if (live == pool.block_bytes.end()) return;  // 不是本池发出的，无从释放
        bytes = live->second;
        if (pool.cached_bytes + bytes <= kPoolMaxCached) {
            pool.free_blocks[&q][bytes].push_back(ptr);
            pool.cached_bytes += bytes;
            return;
        }
        pool.block_bytes.erase(live);
    }
    ::sycl::free(ptr, q);
}

// 直接释放（不入缓存）：入队失败的回退路径用。
void pool_drop(BlockPool& pool, ::sycl::queue& q, void* ptr) {
    {
        std::lock_guard<std::mutex> lock(pool.mtx);
        if (pool.block_bytes.erase(ptr) == 0) return;
    }
    ::sycl::free(ptr, q);
}

void pool_forget(uint64_t context_id) {
    std::shared_ptr<BlockPool> pool;
    {
        std::lock_guard<std::mutex> lock(pools_mutex());
        auto it = pools().find(context_id);
        if (it == pools().end()) return;
        pool = it->second;
        pools().erase(it);
    }
    std::lock_guard<std::mutex> lock(pool->mtx);
    pool->free_blocks.clear();
    pool->block_bytes.clear();
    pool->cached_bytes = 0;
}

}  // namespace

Context::Context(int device_index)
    : device(device_of(device_index)),
      sycl_context(device),
      id(g_next_context_id.fetch_add(1, std::memory_order_relaxed)) {}

Context::~Context() {
    // 只丢账本，不逐个归还：块会随 context 一起被运行时回收（见 pool_forget）。
    pool_forget(id);
    // queue 析构会等待已提交的工作完成，因此 host_task 里的归还一定先跑完。
    for (::sycl::queue* q : queues) {
        try {
            delete q;
        } catch (...) {
            // 析构函数不抛异常；清理失败时无计可施。
        }
    }
}

::sycl::queue& Context::current_queue() {
    const auto it = tls_queue.find(id);
    if (it != tls_queue.end()) return *it->second;

    auto* created = new ::sycl::queue{
        sycl_context, device,
        ::sycl::property_list{::sycl::property::queue::in_order()}};
    {
        std::lock_guard<std::mutex> lock(queues_mutex);
        queues.push_back(created);
    }
    tls_queue[id] = created;
    return *created;
}

extern "C" {

void* sycl_c_context_create(int device_index) {
    try {
        auto* ctx = new Context(device_index);
        // 带 default_selector_v 的队列总会有设备；若设备不可用，首次启动就会
        // 报错。这里返回句柄，使 nullptr（“无设备”）只保留给构造失败。
        return ctx;
    } catch (...) {
        return nullptr;
    }
}

void sycl_c_context_destroy(void* ctx) {
    if (ctx == nullptr) return;
    try {
        delete static_cast<Context*>(ctx);
    } catch (...) {
        // 析构函数不抛异常；清理失败时无计可施。
    }
}

int sycl_c_device_count() {
    try {
        // 只报“装得下我们内核”的设备，见 usable_device_indices。
        return static_cast<int>(usable_device_indices().size());
    } catch (...) {
        return 0;
    }
}

int sycl_c_default_device_index() {
    try {
        const auto devices = sycl::device::get_devices();
        const auto& usable = usable_device_indices();
        // 默认设备 = 可用设备里的第一块 GPU，没有 GPU 就用第一块可用的。
        // 不交给 default_selector_v：它在“GPU + OpenCL CPU”共存时会把 CPU 设备
        // 排在前面，而 CUDA/Vulkan 后端只在 GPU 上选址，默认目标应当一致。
        for (size_t slot = 0; slot < usable.size(); ++slot) {
            if (devices[static_cast<size_t>(usable[slot])].is_gpu())
                return static_cast<int>(slot);
        }
        return usable.empty() ? -1 : 0;
    } catch (...) {
        return -1;
    }
}

const char* sycl_c_last_error() {
    return t_last_error.empty() ? nullptr : t_last_error.c_str();
}

void sycl_c_record_error(const char* what) {
    if (what == nullptr) {
        t_last_error.clear();
    } else {
        t_last_error = what;
    }
}

int sycl_c_wait(void* ctx) {
    if (ctx == nullptr) return tvv::sycl::kSyclInvalid;
    auto* context = static_cast<Context*>(ctx);
    try {
        // 设备级契约是“所有队列空闲”，与 cudaDeviceSynchronize / torch.cuda.synchronize
        // 一致。先快照队列列表再逐个等待，等待期间不持锁——其他线程建新队列不会被
        // 卡住（那条队列此刻还没有本调用可见的工作）。
        std::vector<::sycl::queue*> snapshot;
        {
            std::lock_guard<std::mutex> lock(context->queues_mutex);
            snapshot = context->queues;
        }
        for (::sycl::queue* q : snapshot) {
            q->wait_and_throw();
            tensorvia::sync::note_wait(tensorvia::sync::Wait::Synchronize);
        }
        return tvv::sycl::kSyclOk;
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

void* sycl_c_current_queue(void* ctx) {
    if (ctx == nullptr) return nullptr;
    try {
        return &queue_of(ctx);
    } catch (...) {
        return nullptr;
    }
}

int sycl_c_device_name(void* ctx, char* out, int cap) {
    if (ctx == nullptr || out == nullptr || cap <= 0) return tvv::sycl::kSyclInvalid;
    try {
        // 问 context 而不是队列：命名是设备属性，不该为一个名字凭空造条队列。
        const auto name = static_cast<Context*>(ctx)
                              ->device.get_info<sycl::info::device::name>();
        const size_t n = name.size() < static_cast<size_t>(cap - 1)
                             ? name.size()
                             : static_cast<size_t>(cap - 1);
        std::memcpy(out, name.c_str(), n);
        out[n] = '\0';
        return static_cast<int>(n);
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

void* sycl_c_malloc(void* ctx, void* queue, size_t bytes) {
    if (ctx == nullptr) return nullptr;
    try {
        // malloc_device(0) 不可移植；零字节张量仍需有效句柄，好让析构与拷贝路径
        // 保持统一。没有句柄时退回调用线程的队列。
        ::sycl::queue& q = queue == nullptr ? queue_of(ctx) : queue_from_handle(queue);
        return pool_take(*pool_of(static_cast<const Context*>(ctx)->id), q, bytes);
    } catch (...) {
        return nullptr;
    }
}

void sycl_c_free(void* ctx, void* queue_handle, void* ptr) {
    if (ctx == nullptr || ptr == nullptr) return;
    if (queue_handle == nullptr) queue_handle = sycl_c_current_queue(ctx);
    if (queue_handle == nullptr) return;
    // 归还交还给**分配该块的那条队列**：块可能仍被那条队列里尚未完成的 kernel
    // 引用，in-order 特性保证这个 host task 排在它们之后。别的队列上的后续工作
    // 不在本契约内（跨线程交接本就要求显式同步）。
    auto& q = queue_from_handle(queue_handle);
    // 句柄随 host task 一起活下去：即使 context 先析构，归还也只是写进一个没人
    // 再用的池子，不会踩到已释放对象。
    std::shared_ptr<BlockPool> pool = pool_of(static_cast<const Context*>(ctx)->id);
    try {
        q.submit([ptr, &q, pool](sycl::handler& h) {
            h.host_task([ptr, &q, pool] { pool_put(*pool, q, ptr); });
        });
    } catch (...) {
        // 入队失败：先等队列清空再直接释放。慢，但不会释放仍在使用的内存。
        try {
            q.wait_and_throw();
        } catch (...) {
        }
        pool_drop(*pool, q, ptr);
    }
}

int sycl_c_memcpy(void* ctx, void* dst, const void* src, size_t bytes, int kind) {
    if (ctx == nullptr || dst == nullptr || src == nullptr) return tvv::sycl::kSyclInvalid;
    if (bytes == 0) return tvv::sycl::kSyclOk;
    if (kind != tvv::sycl::kHostToDevice && kind != tvv::sycl::kDeviceToHost &&
        kind != tvv::sycl::kDeviceToDevice)
        return tvv::sycl::kSyclInvalid;
    try {
        // queue::memcpy 选择 USM 拷贝路径；in-order 队列加上下面的等待，使拷贝在
        // 调用方 buffer 销毁前完成。
        queue_of(ctx).memcpy(dst, src, bytes).wait_and_throw();
        tensorvia::sync::note_wait(tensorvia::sync::Wait::Copy);
        return tvv::sycl::kSyclOk;
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

}  // extern "C"
