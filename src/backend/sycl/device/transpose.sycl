#include "common.h"

using namespace tvv::sycl_dev;

namespace {

constexpr size_t kTile = 32;
constexpr size_t kTileRows = 8;

template <class T>
void transpose2d_kernel(sycl::queue& q, const T* in, T* out, int64_t rows,
                        int64_t cols) {
    const size_t grid_x = static_cast<size_t>((cols + kTile - 1) / kTile);
    const size_t grid_y = static_cast<size_t>((rows + kTile - 1) / kTile);
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<T, 1> tile(sycl::range<1>(kTile * (kTile + 1)), h);
        h.parallel_for(
            sycl::nd_range<2>(sycl::range<2>(grid_y * kTileRows, grid_x * kTile),
                              sycl::range<2>(kTileRows, kTile)),
            [=](sycl::nd_item<2> item) {
                const size_t ly = item.get_local_id(0);
                const size_t lx = item.get_local_id(1);
                const int64_t col = static_cast<int64_t>(item.get_group(1) * kTile) +
                                    static_cast<int64_t>(lx);
                const int64_t row0 = static_cast<int64_t>(item.get_group(0) * kTile) +
                                     static_cast<int64_t>(ly);
                if (col < cols) {
                    for (size_t j = 0; j < kTile; j += kTileRows) {
                        const int64_t row = row0 + static_cast<int64_t>(j);
                        if (row < rows)
                            tile[(ly + j) * (kTile + 1) + lx] = in[row * cols + col];
                    }
                }
                item.barrier(sycl::access::fence_space::local_space);
                // 转置后的坐标仍是 2-D 连续行主序：(col, row) -> out[row_out * rows + col_out]。
                const int64_t out_col = static_cast<int64_t>(item.get_group(0) * kTile) +
                                        static_cast<int64_t>(lx);
                const int64_t out_row0 = static_cast<int64_t>(item.get_group(1) * kTile) +
                                         static_cast<int64_t>(ly);
                if (out_col < rows) {
                    for (size_t j = 0; j < kTile; j += kTileRows) {
                        const int64_t out_row = out_row0 + static_cast<int64_t>(j);
                        if (out_row < cols)
                            out[out_row * rows + out_col] =
                                tile[lx * (kTile + 1) + ly + j];
                    }
                }
            });
    });
}

// 2-D、连续输入、恒等之外的 (1,0) 置换：rows x cols -> cols x rows。
inline bool is_transpose2d(const tvv::sycl::Transpose& p, int64_t& rows, int64_t& cols) {
    if (p.ndim != 2) return false;
    if (p.axes[0] != 1 || p.axes[1] != 0) return false;
    rows = p.in_shape[0];
    cols = p.in_shape[1];
    if (rows <= 0 || cols <= 0) return false;
    return p.in_strides[0] == cols && p.in_strides[1] == 1 &&
           p.out_strides[0] == rows && p.out_strides[1] == 1;
}

template <class T, int N>
void transpose_permute_tiled_kernel(sycl::queue& q, const T* in, T* out,
                                    const tvv::sycl::Transpose& p, int od_s) {
    constexpr int od_c = N - 1;  // 输出最内轴

    const int64_t len_s = p.in_shape[N - 1];  // 沿 od_s 的输出长度（输入最内轴）
    int64_t len_c = 0;                        // 沿 od_c 的输出长度
    int64_t stride_x = 0;                     // 装载时相邻 lane 的跨度（沿 od_c）
    #pragma unroll
    for (int k = 0; k < N; ++k)
        if (p.axes[N - 1] == k) {
            len_c = p.in_shape[k];
            stride_x = p.in_strides[k];
        }
    int64_t stride_y = 0;  // 写出时相邻 lane 的跨度（沿 od_s）
    #pragma unroll
    for (int k = 0; k < N; ++k)
        if (k == od_s) stride_y = p.out_strides[k];

    int64_t batches = 1;
    for (int d = 0; d < N; ++d) {
        int e = -1;
        for (int k = 0; k < N; ++k)
            if (p.axes[k] == d) e = k;
        if (e != od_s && e != od_c) batches *= p.in_shape[d];
    }

    const size_t grid_s = static_cast<size_t>((len_s + kTile - 1) / kTile);
    const size_t grid_c = static_cast<size_t>((len_c + kTile - 1) / kTile);

    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<T, 1> tile(sycl::range<1>(kTile * (kTile + 1)), h);
        h.parallel_for(
            sycl::nd_range<3>(
                sycl::range<3>(grid_s * kTileRows, grid_c * kTile,
                               static_cast<size_t>(batches)),
                sycl::range<3>(kTileRows, kTile, 1)),
            [=](sycl::nd_item<3> item) {
                const size_t la = item.get_local_id(0);  // 装载走 od_c，写出走 od_s
                const size_t lb = item.get_local_id(1);  // lane 最快维，装载走 od_s

                // batch 坐标只解一次：两个基准偏移在整块 tile 内共用。
                int64_t rem = static_cast<int64_t>(item.get_group(2));
                int64_t in_base = 0;
                int64_t out_base = 0;
                #pragma unroll
                for (int d = N - 1; d >= 0; --d) {
                    int e = -1;
                    #pragma unroll
                    for (int k = 0; k < N; ++k)
                        if (p.axes[k] == d) e = k;
                    if (e == od_s || e == od_c) continue;
                    const int64_t dim = p.in_shape[d];
                    if (dim <= 0) continue;
                    const int64_t c = rem % dim;
                    rem /= dim;
                    in_base += c * p.in_strides[d];
                    #pragma unroll
                    for (int k = 0; k < N; ++k)
                        if (k == e) out_base += c * p.out_strides[k];
                }

                // 装载：lane 沿输入最内轴——连续读。每个工作项沿 od_c 扫
                // kTileRows 条，凑满 tile 的 32 行。
                const int64_t ys = static_cast<int64_t>(item.get_group(0) * kTile +
                                                        lb);
                const int64_t xc0 = static_cast<int64_t>(item.get_group(1) * kTile +
                                                         la);
                if (ys < len_s) {
                    for (size_t j = 0; j < kTile; j += kTileRows) {
                        const int64_t xc = xc0 + static_cast<int64_t>(j);
                        if (xc < len_c)
                            tile[(la + j) * (kTile + 1) + lb] =
                                in[in_base + ys + xc * stride_x];
                    }
                }
                item.barrier(sycl::access::fence_space::local_space);
                // 写出：lane 沿输出最内轴——连续写，tile 换向取元素。
                const int64_t x_out = static_cast<int64_t>(item.get_group(1) * kTile +
                                                           lb);
                const int64_t y_out0 = static_cast<int64_t>(item.get_group(0) * kTile +
                                                            la);
                if (x_out < len_c) {
                    for (size_t j = 0; j < kTile; j += kTileRows) {
                        const int64_t y_out = y_out0 + static_cast<int64_t>(j);
                        if (y_out < len_s)
                            out[out_base + y_out * stride_y + x_out] =
                                tile[lb * (kTile + 1) + la + j];
                    }
                }
            });
    });
}

// 通用路径：用输入步长解码连续输入下标，再在输出中编码置换后的坐标。
template <class T, int N>
void transpose_generic_kernel(sycl::queue& q, const T* in, T* out,
                              const tvv::sycl::Transpose& p) {
    q.parallel_for(range_of(p.numel), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        int64_t rem = i;
        int64_t out_off = 0;
        #pragma unroll
        for (int d = 0; d < N; ++d) {
            const int64_t s = p.in_strides[d];
            const int64_t c = s > 0 ? rem / s : 0;
            if (s > 0) rem %= s;
            #pragma unroll
            for (int k = 0; k < N; ++k)
                if (p.axes[k] == d) out_off += c * p.out_strides[k];
        }
        out[out_off] = in[i];
    });
}

// 高维（>4）很少见，用不展开的通用路径即可，省掉一批模板实例。
template <class T>
void transpose_generic_dynamic_kernel(sycl::queue& q, const T* in, T* out,
                                      const tvv::sycl::Transpose& p) {
    q.parallel_for(range_of(p.numel), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        int64_t rem = i;
        int64_t coord[kMaxDims] = {};
        for (int d = 0; d < p.ndim; ++d) {
            const int64_t s = p.in_strides[d];
            coord[d] = s > 0 ? rem / s : 0;
            if (s > 0) rem %= s;
        }
        int64_t out_off = 0;
        for (int d = 0; d < p.ndim; ++d) out_off += coord[p.axes[d]] * p.out_strides[d];
        out[out_off] = in[i];
    });
}

// 分块路径的适用条件：两侧最内轴都连续，且最内轴确实被搬到了别的输出位置。
template <class T, int N>
inline void transpose_rank_kernel(sycl::queue& q, const T* in, T* out,
                                  const tvv::sycl::Transpose& p) {
    if (p.in_strides[N - 1] == 1 && p.out_strides[N - 1] == 1) {
        int od_s = -1;
        #pragma unroll
        for (int d = 0; d < N; ++d)
            if (p.axes[d] == N - 1) od_s = d;
        if (od_s >= 0 && od_s != N - 1) {
            transpose_permute_tiled_kernel<T, N>(q, in, out, p, od_s);
            return;
        }
    }
    transpose_generic_kernel<T, N>(q, in, out, p);
}

template <class T>
void transpose_kernel(sycl::queue& q, const T* in, T* out,
                      const tvv::sycl::Transpose& p) {
    int64_t rows = 0;
    int64_t cols = 0;
    if (is_transpose2d(p, rows, cols)) {
        transpose2d_kernel<T>(q, in, out, rows, cols);
        return;
    }
    switch (p.ndim) {
        case 1: transpose_rank_kernel<T, 1>(q, in, out, p); return;
        case 2: transpose_rank_kernel<T, 2>(q, in, out, p); return;
        case 3: transpose_rank_kernel<T, 3>(q, in, out, p); return;
        case 4: transpose_rank_kernel<T, 4>(q, in, out, p); return;
        default: transpose_generic_dynamic_kernel<T>(q, in, out, p); return;
    }
}

}  // namespace

extern "C" {

int sycl_c_launch_transpose(void* ctx, const void* in, void* out, int dtype,
                            const tvv::sycl::Transpose* p) {
    if (ctx == nullptr || in == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    if (p->ndim <= 0 || p->ndim > kMaxDims) return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            transpose_kernel<T>(q, static_cast<const T*>(in), static_cast<T*>(out), *p);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

}  // extern "C"
