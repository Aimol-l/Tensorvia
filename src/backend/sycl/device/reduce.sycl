#include "common.h"

using namespace tvv::sycl_dev;
namespace contract = tvv::sycl_dev::contract;

namespace {

template <class T>
inline constexpr bool prod_uses_wide_acc =
    std::is_floating_point_v<T> || is_low_precision<T>::value;

template <class T, class F>
inline void with_reduce_acc(int op, F&& f) {
    if constexpr (prod_uses_wide_acc<T>) {
        if (op == tvv::sycl::kReduceProd) {
            f(type_tag<double>{});
            return;
        }
    }
    (void)op;
    f(type_tag<reduction_acc_t<T>>{});
}

template <class Acc>
inline Acc identity_acc(int op) {
    if (op == tvv::sycl::kReduceSum || op == tvv::sycl::kReduceMean) return Acc(0);
    if (op == tvv::sycl::kReduceProd) return Acc(1);
    if (op == tvv::sycl::kReduceMin) return max_finite<Acc>();
    return lowest_finite<Acc>();
}

template <class Acc>
inline Acc combine_acc(Acc a, Acc b, int op) {
    if (op == tvv::sycl::kReduceSum || op == tvv::sycl::kReduceMean) return a + b;
    if (op == tvv::sycl::kReduceProd) return a * b;
    if (op == tvv::sycl::kReduceMin) return contract::min_contract(a, b);
    return contract::max_contract(a, b);
}

// 一个 work-group 的树形归约。工作项数必须是 2 的幂（所有调用点都是 kWorkGroup）。
template <class Acc>
inline Acc block_reduce(sycl::nd_item<1> item, sycl::local_accessor<Acc, 1> scratch,
                        Acc acc, int op) {
    const size_t lid = item.get_local_id(0);
    const size_t n = item.get_local_range(0);
    scratch[lid] = acc;
    item.barrier(sycl::access::fence_space::local_space);
    for (size_t s = n / 2; s > 0; s >>= 1) {
        if (lid < s) scratch[lid] = combine_acc(scratch[lid], scratch[lid + s], op);
        item.barrier(sycl::access::fence_space::local_space);
    }
    return scratch[0];
}

template <class T, class Out, class Acc>
void reduce_axis_kernel(sycl::queue& q, const T* in, Out* out,
                        const tvv::sycl::ReduceAxis& p, int op) {
    const int64_t total = p.outer * p.inner;
    // 轴循环按真实元素数截断：正常布局下恒等，只有两趟全归约的趟 1 末段会短于
    // axis。每个输出只多一次 min，不在内层循环里。
    const int64_t numel = p.numel > 0 ? p.numel : p.outer * p.axis * p.inner;
    q.parallel_for(range_of(total), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        const int64_t outer_idx = i / p.inner;
        const int64_t inner_idx = i % p.inner;
        const int64_t base = outer_idx * p.axis * p.inner + inner_idx;
        const int64_t limit = sycl::min(p.axis, numel - base);

        Acc acc;
        if (op == tvv::sycl::kReduceSum || op == tvv::sycl::kReduceMean) {
            acc = Acc(0);
            for (int64_t k = 0; k < limit; ++k)
                acc += static_cast<Acc>(to_compute<Acc>(in[base + k * p.inner]));
        } else if (op == tvv::sycl::kReduceProd) {
            acc = Acc(1);
            for (int64_t k = 0; k < limit; ++k)
                acc *= static_cast<Acc>(to_compute<Acc>(in[base + k * p.inner]));
        } else if (op == tvv::sycl::kReduceMin) {
            acc = to_compute<Acc>(in[base]);
            for (int64_t k = 1; k < limit; ++k)
                acc = contract::min_contract(acc, to_compute<Acc>(in[base + k * p.inner]));
        } else {
            acc = to_compute<Acc>(in[base]);
            for (int64_t k = 1; k < limit; ++k)
                acc = contract::max_contract(acc, to_compute<Acc>(in[base + k * p.inner]));
        }
        if (op == tvv::sycl::kReduceMean) {
            const double denom =
                p.mean_n > 0 ? static_cast<double>(p.mean_n) : static_cast<double>(p.axis);
            out[i] = store_as<Out>(static_cast<double>(acc) / denom);
        } else {
            out[i] = store_as<Out>(acc);
        }
    });
}

template <class T, class Out, class Acc>
void reduce_axis_inner1_kernel(sycl::queue& q, const T* in, Out* out,
                               const tvv::sycl::ReduceAxis& p, int op) {
    const int64_t numel = p.numel > 0 ? p.numel : p.outer * p.axis;
    const double denom =
        p.mean_n > 0 ? static_cast<double>(p.mean_n) : static_cast<double>(p.axis);
    const size_t n = kWorkGroup;
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<Acc, 1> scratch(sycl::range<1>(n), h);
        h.parallel_for(
            sycl::nd_range<1>(sycl::range<1>(static_cast<size_t>(p.outer) * n),
                              sycl::range<1>(n)),
            [=](sycl::nd_item<1> item) {
                const size_t lid = item.get_local_id(0);
                const int64_t row = static_cast<int64_t>(item.get_group(0));
                const int64_t base = row * p.axis;
                const int64_t limit = sycl::min(p.axis, numel - base);
                Acc acc = identity_acc<Acc>(op);
                for (int64_t i = static_cast<int64_t>(lid); i < limit;
                     i += static_cast<int64_t>(n))
                    acc = combine_acc(acc, to_compute<Acc>(in[base + i]), op);
                acc = block_reduce<Acc>(item, scratch, acc, op);
                if (lid == 0) {
                    out[row] = (op == tvv::sycl::kReduceMean)
                                   ? store_as<Out>(static_cast<double>(acc) / denom)
                                   : store_as<Out>(acc);
                }
            });
    });
}

// 全归约趟 1：`blocks` 段连续区间，每段一个 work-group。段内按工作项跨步读
// （合并访存），组内树形归约后写出一个部分值。末段可能为空，写出的正是单位元。
template <class T, class Out, class Acc>
void reduce_partial_kernel(sycl::queue& q, const T* in, Out* out, int64_t numel,
                           int64_t chunk, int64_t blocks, int op) {
    const size_t n = kWorkGroup;
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<Acc, 1> scratch(sycl::range<1>(n), h);
        h.parallel_for(
            sycl::nd_range<1>(sycl::range<1>(static_cast<size_t>(blocks) * n),
                              sycl::range<1>(n)),
            [=](sycl::nd_item<1> item) {
                const size_t lid = item.get_local_id(0);
                const int64_t begin = static_cast<int64_t>(item.get_group(0)) * chunk;
                const int64_t end = sycl::min(begin + chunk, numel);
                Acc acc = identity_acc<Acc>(op);
                for (int64_t i = begin + static_cast<int64_t>(lid); i < end;
                     i += static_cast<int64_t>(n))
                    acc = combine_acc(acc, to_compute<Acc>(in[i]), op);
                acc = block_reduce<Acc>(item, scratch, acc, op);
                if (lid == 0)
                    out[item.get_group(0)] = store_as<Out>(acc);
            });
    });
}

template <class T>
void arg_reduce_kernel(sycl::queue& q, const T* in, int32_t* out,
                       const tvv::sycl::ReduceAxis& p, int is_max) {
    const int64_t total = p.outer * p.inner;
    q.parallel_for(range_of(total), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        const int64_t outer_idx = i / p.inner;
        const int64_t inner_idx = i % p.inner;
        const int64_t base = outer_idx * p.axis * p.inner + inner_idx;

        T best = in[base];
        int64_t best_idx = 0;
        for (int64_t k = 1; k < p.axis; ++k) {
            const T v = in[base + k * p.inner];
            const bool better = is_max ? contract::argmax_better(v, best)
                                       : contract::argmin_better(v, best);
            if (better) {
                best = v;
                best_idx = k;
            }
        }
        out[i] = static_cast<int32_t>(best_idx);
    });
}

// 目标字由同一 in-order 队列上一个单工作项的启动初始化，随后每个工作组折叠自己的
// 片段并做一次原子合并。宿主永远不必清零设备内存。
void init_uint_kernel(sycl::queue& q, unsigned int* out, unsigned int value) {
    q.parallel_for(sycl::range<1>(1), [=](sycl::id<1>) { out[0] = value; });
}

void init_ull_kernel(sycl::queue& q, unsigned int* out) {
    q.parallel_for(sycl::range<1>(1), [=](sycl::id<1>) { out[0] = 0u; });
}

template <class T>
void all_any_kernel(sycl::queue& q, const T* in, unsigned int* out, int64_t numel,
                    int is_all, double value) {
    const size_t n = kWorkGroup;
    const int64_t groups = numel <= 0 ? 1
                                      : (numel + static_cast<int64_t>(n) - 1) /
                                            static_cast<int64_t>(n);
    const float val = static_cast<float>(value);
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<int, 1> sdata(sycl::range<1>(n), h);
        h.parallel_for(
            sycl::nd_range<1>(sycl::range<1>(static_cast<size_t>(groups) * n),
                              sycl::range<1>(n)),
            [=](sycl::nd_item<1> item) {
                const size_t lid = item.get_local_id(0);
                const int64_t start = static_cast<int64_t>(item.get_group(0) * n + lid);
                const int64_t stride = static_cast<int64_t>(groups) * n;
                bool ok = is_all != 0;
                for (int64_t i = start; i < numel; i += stride) {
                    const bool hit = contract::match_value<T>(in[i], val);
                    ok = is_all ? (ok && hit) : (ok || hit);
                }
                sdata[lid] = ok ? 1 : 0;
                item.barrier(sycl::access::fence_space::local_space);
                for (size_t s = n / 2; s > 0; s >>= 1) {
                    if (lid < s) {
                        if (is_all) sdata[lid] &= sdata[lid + s];
                        else        sdata[lid] |= sdata[lid + s];
                    }
                    item.barrier(sycl::access::fence_space::local_space);
                }
                if (lid == 0) {
                    sycl::atomic_ref<unsigned int, sycl::memory_order::relaxed,
                                     sycl::memory_scope::device,
                                     sycl::access::address_space::global_space>
                        word(out[0]);
                    if (is_all) word.fetch_and(static_cast<unsigned int>(sdata[0]));
                    else        word.fetch_or(static_cast<unsigned int>(sdata[0]));
                }
            });
    });
}

template <class T>
void nonzero_count_kernel(sycl::queue& q, const T* in, unsigned int* out, int64_t numel) {
    q.parallel_for(range_of(numel), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        if (in[i] != T(0)) {
            sycl::atomic_ref<unsigned int, sycl::memory_order::relaxed,
                             sycl::memory_scope::device,
                             sycl::access::address_space::global_space>
                word(out[0]);
            word.fetch_add(1u);
        }
    });
}

}  // namespace

extern "C" {

int sycl_c_launch_reduce_axis(void* ctx, const void* in, void* out,
                              int in_dtype, int out_dtype, int op,
                              const tvv::sycl::ReduceAxis* p) {
    if (ctx == nullptr || in == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(in_dtype, [&](auto src_tag) -> int {
            using T = typename decltype(src_tag)::type;
            return dispatch_dtype(out_dtype, [&](auto dst_tag) -> int {
                using Out = typename decltype(dst_tag)::type;
                with_reduce_acc<T>(op, [&](auto acc_tag) -> void {
                    using Acc = typename decltype(acc_tag)::type;
                    if (p->inner == 1 && p->axis >= 64)
                        reduce_axis_inner1_kernel<T, Out, Acc>(
                            q, static_cast<const T*>(in), static_cast<Out*>(out), *p, op);
                    else
                        reduce_axis_kernel<T, Out, Acc>(
                            q, static_cast<const T*>(in), static_cast<Out*>(out), *p, op);
                });
                return tvv::sycl::kSyclOk;
            });
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_reduce_partial(void* ctx, const void* in, void* out, int64_t numel,
                                 int in_dtype, int out_dtype, int op, int64_t blocks) {
    if (ctx == nullptr || in == nullptr || out == nullptr || numel <= 0 || blocks <= 0)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        const int64_t chunk = (numel + blocks - 1) / blocks;
        return dispatch_dtype(in_dtype, [&](auto src_tag) -> int {
            using T = typename decltype(src_tag)::type;
            return dispatch_dtype(out_dtype, [&](auto dst_tag) -> int {
                using Out = typename decltype(dst_tag)::type;
                with_reduce_acc<T>(op, [&](auto acc_tag) -> void {
                    using Acc = typename decltype(acc_tag)::type;
                    reduce_partial_kernel<T, Out, Acc>(
                        q, static_cast<const T*>(in), static_cast<Out*>(out), numel,
                        chunk, blocks, op);
                });
                return tvv::sycl::kSyclOk;
            });
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_arg_reduce(void* ctx, const void* in, void* out, int dtype,
                             int is_max, const tvv::sycl::ReduceAxis* p) {
    if (ctx == nullptr || in == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            arg_reduce_kernel<T>(q, static_cast<const T*>(in),
                                 static_cast<int32_t*>(out), *p, is_max);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_all_any(void* ctx, const void* in, void* out, int64_t numel,
                          int dtype, int is_all, double value) {
    if (ctx == nullptr || in == nullptr || out == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        init_uint_kernel(q, static_cast<unsigned int*>(out),
                         is_all ? 1u : 0u);
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            all_any_kernel<T>(q, static_cast<const T*>(in),
                              static_cast<unsigned int*>(out), numel, is_all, value);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

int sycl_c_launch_nonzero(void* ctx, const void* in, void* out, int64_t numel,
                          int dtype) {
    if (ctx == nullptr || in == nullptr || out == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        init_ull_kernel(q, static_cast<unsigned int*>(out));
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            nonzero_count_kernel<T>(q, static_cast<const T*>(in),
                                    static_cast<unsigned int*>(out), numel);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

}  // extern "C"
