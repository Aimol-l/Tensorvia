// 逐元素 dtype 转换。
#include "common.h"

using namespace tvv::sycl_dev;

namespace {

template <class T, class R>
void cast_kernel(sycl::queue& q, const T* in, R* out, int64_t numel) {
    using C = promoted_t<T>;
    q.parallel_for(range_of(numel), [=](sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        if constexpr (std::is_same_v<R, uint8_t>) {
            // 数值 -> BOOL：任何非零值都为真，写为 1。
            out[i] = to_compute<C>(in[i]) != C(0) ? uint8_t{1} : uint8_t{0};
        } else if constexpr (std::is_same_v<T, uint8_t>) {
            // BOOL -> 数值：真为 1，假为 0（绝不用原始字节）。
            out[i] = store_as<R>(C(in[i] != 0 ? 1 : 0));
        } else {
            out[i] = store_as<R>(to_compute<C>(in[i]));
        }
    });
}

}  // namespace

extern "C" {

int sycl_c_launch_cast(void* ctx, const void* in, void* out, int64_t numel,
                       int in_dtype, int out_dtype) {
    if (ctx == nullptr || in == nullptr || out == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        return dispatch_dtype(in_dtype, [&](auto src_tag) -> int {
            using T = typename decltype(src_tag)::type;
            return dispatch_dtype(out_dtype, [&](auto dst_tag) -> int {
                using R = typename decltype(dst_tag)::type;
                cast_kernel<T, R>(q, static_cast<const T*>(in),
                                  static_cast<R*>(out), numel);
                return tvv::sycl::kSyclOk;
            });
        });
    } catch (...) {
        return tvv::sycl::kSyclFailure;
    }
}

}  // extern "C"
