// Device::SYCL 的 2-D 池化（Max / Avg）。
//
// 一个输出元素 = 一个工作项的一次窗口扫描：池化是带宽型操作，无 shared
// memory tiling 的必要（与 CUDA 后端同一判断）。半精度在 promoted_t<T>
// （float）里累加后写回；Max 的哨兵用首值初始化而非 numeric_limits——
// 宿主 constexpr 函数在设备代码里用不得（common.h 的 max_finite 注释）。
// 窗口整体越界填 0，Avg 的分母恒为 kh*kw（count_include_pad）。
#include "common.h"

using namespace tvv::sycl_dev;

namespace {

template <class T, bool kAvg>
void pool2d_kernel(::sycl::queue& q, const T* in, T* out, const tvv::sycl::Pool2d& p) {
    using Acc = promoted_t<T>;
    const int64_t total = p.batch * p.channels * p.out_h * p.out_w;
    q.parallel_for(range_of(total), [=](::sycl::id<1> idx) {
        const int64_t i = static_cast<int64_t>(idx[0]);
        const int64_t ox = i % p.out_w;
        int64_t rest     = i / p.out_w;
        const int64_t oy = rest % p.out_h;
        rest /= p.out_h;
        const int64_t c  = rest % p.channels;
        const int64_t n  = rest / p.channels;

        const int64_t in_plane  = p.in_h * p.in_w;
        const int64_t out_plane = p.out_h * p.out_w;
        const T* in_plane_ptr = in + (n * p.channels + c) * in_plane;

        Acc acc    = Acc(0);
        bool first = true;
        int64_t count = 0;
        for (int64_t ii = 0; ii < p.kh; ++ii) {
            const int64_t y = oy * p.stride_h + ii - p.padding;
            if (y < 0 || y >= p.in_h) continue;
            const T* in_row = in_plane_ptr + y * p.in_w;
            for (int64_t jj = 0; jj < p.kw; ++jj) {
                const int64_t x = ox * p.stride_w + jj - p.padding;
                if (x < 0 || x >= p.in_w) continue;
                const Acc v = to_compute<Acc>(in_row[x]);
                if constexpr (kAvg) {
                    acc += v;
                } else if (first || v > acc) {
                    acc   = v;
                    first = false;
                }
                ++count;
            }
        }
        // 窗口整体越界（没有真值）时填 0，Avg 也免了除零。
        const Acc result = count == 0 ? Acc(0)
                                      : (kAvg ? acc / static_cast<Acc>(p.kh * p.kw) : acc);
        out[(n * p.channels + c) * out_plane + oy * p.out_w + ox] = store_as<T>(result);
    });
}

}  // namespace

extern "C" {

int sycl_c_launch_pool2d(void* ctx, const void* in, void* out, int dtype,
                         const tvv::sycl::Pool2d* p, int average) {
    if (ctx == nullptr || in == nullptr || out == nullptr || p == nullptr)
        return tvv::sycl::kSyclInvalid;
    try {
        auto& q = queue_of(ctx);
        // *p 解引用成值再进 kernel 包装函数：lambda 按值捕获的是这份拷贝，
        // 设备不碰宿主指针（repack 的 shape/strides 直穿是反例）。
        return dispatch_dtype(dtype, [&](auto tag) -> int {
            using T = typename decltype(tag)::type;
            if (average)
                pool2d_kernel<T, true>(q, static_cast<const T*>(in), static_cast<T*>(out),
                                       *p);
            else
                pool2d_kernel<T, false>(q, static_cast<const T*>(in), static_cast<T*>(out),
                                        *p);
            return tvv::sycl::kSyclOk;
        });
    } catch (const std::exception& e) {
        return record_failure(e);
    } catch (...) {
        return record_failure();
    }
}

}  // extern "C"
