{
  // cpptools 的语义层配置。.cpp/.ixx 走根目录 compile_commands.json
  // （mcpp.toml 的 compile_commands 键生成）；这里补 .sycl 的兜底：
  // 设备单元不进构建数据库，用 includePath 给它可索引的语义。
  // DPC++/llvm 的 payload 路径随版本变，升级后同步这里。
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src/backend/sycl",
        "${workspaceFolder}/src/backend/cuda",
        "${userHome}/.mcpp/registry/data/xpkgs/xim-x-dpcpp/7.1.0/include",
        "${userHome}/.mcpp/registry/data/xpkgs/xim-x-llvm/22.1.8/include/c++/v1"
      ],
      "defines": [
        "BACKEND_SYCL",
        "BACKEND_CUDA"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-clang-x64"
    }
  ]
}
