# Public surface exported by the mcpp module wrapper (src/interface/tensorvia.ixx).
# One name per line. `tools/gen_facade.py` turns this into `export using ::name;`
# / `export namespace ns { using ::ns::name; }`, and its --check also fails when a
# public declaration in include/tensorvia/*.hpp is missing here (or listed in
# [ignore], which marks a name as deliberately internal).
#
# Keep in sync with the export blocks of the interfaces; tests/facade_api.cpp
# compiles every name through `import tensorvia;`, so a missing entry fails the
# build instead of silently shrinking the public API.

[global]
float32
float64
float16
bfloat16
kMaxTensorDims
DimArray
compute_type_helper
compute_type_t
OpType
Device
DeviceId
DeviceIdHash
DataType
is_bool_dtype
is_integer_dtype
is_floating_dtype
is_integral_dtype
default_dtype
set_default_dtype
default_device
set_default_device
TensorOptions
op_to_string
device_to_string
device_id_to_string
dtype_to_string
make_pipeline_key
reduction_type
float_reduction_type
calc_dtype_size
