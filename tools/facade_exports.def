# Public surface re-exported by the header-first module facade
# (src/interface/header_core.cppm). One name per line. `tools/gen_facade.py`
# turns this into `export using ::name;` / `export namespace ns { using ::ns::name; }`.
#
# Keep in sync with the export blocks of the interfaces; tests/facade_api.cpp
# compiles every name through `import tensorvia;`, so a missing entry fails the
# build instead of silently shrinking the public API.

[global]
float32
float64
float16
bfloat16
kMaxTensorDims
DimArray
compute_type_helper
compute_type_t
OpType
Device
DataType
op_to_string
device_to_string
dtype_to_string
make_pipeline_key
reduction_type
float_reduction_type
calc_dtype_size
CppDTypeVariant
ConstCppDTypeVariant
make_variant
data_as_const_variant
dispatch_dtype
valid_casts
compute_type
is_cast_valid
calc_numel
Metadata
TensorImpl
Tensor
ContextImpl
CPUContext
TensorImplFactory
BackendInitializer
register_tensor_impl
register_backend_initializer
create_tensor_impl
copy_device_to_host
copy_host_to_device

