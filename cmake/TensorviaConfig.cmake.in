@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The backends actually compiled into the installed library.
set(TENSORVIA_WITH_VULKAN @BACKEND_VULKAN@)
set(TENSORVIA_WITH_CUDA   @BACKEND_CUDA@)
set(TENSORVIA_WITH_CPU    @BACKEND_CPU@)

if(TENSORVIA_WITH_CPU)
    find_dependency(OpenMP)
endif()
if(TENSORVIA_WITH_VULKAN)
    find_dependency(Vulkan)
endif()
# CUDA is linked privately as a shared runtime, so consumers do not need the
# toolkit to include or link the installed library.

include("${CMAKE_CURRENT_LIST_DIR}/TensorviaTargets.cmake")

check_required_components(Tensorvia)
