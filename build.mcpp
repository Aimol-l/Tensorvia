// Build-time work for the optional backends.
//
// One lane: the headers under include/ are the sources of truth. The only
// module unit is the thin wrapper src/interface/tensorvia.ixx (its export
// block is generated from tools/facade_exports.def); every host unit is an
// ordinary .cpp that #includes the headers, and the .cu device units compile
// against the same headers through rules-cuda.
//
// This program therefore owns source selection: mcpp.toml only names the root.
import std;
import mcpp;
import mcpp.plugins;
import mcpp.plugins.tool;
import mcpp.rules.cuda;
import mcpp.rules.sycl;
import mcpp.rules.spirv;

namespace {

std::string join(const std::string& base, const std::string& rel) {
    return base + "/" + rel;
}

// Every regular file under `dir` whose extension matches.
std::vector<std::string> files_with_extension(const std::string& dir,
                                              const std::string& extension) {
    std::vector<std::string> out;
    std::error_code ec;
    if (!std::filesystem::is_directory(dir, ec)) return out;
    for (const auto& entry : std::filesystem::recursive_directory_iterator(dir, ec)) {
        if (!entry.is_regular_file()) continue;
        if (entry.path().extension() == extension) out.push_back(entry.path().string());
    }
    std::sort(out.begin(), out.end());
    return out;
}

// Emit the library's source set: the wrapper module comes from [lib] path;
// every host translation unit is named here so a removed file fails loudly
// instead of silently dropping a definition. Headers are the sources of
// truth — only the wrapper module and the .cpp units compile. The three
// device backends gate on their lane (feature AND accelerator), so
// `mcpp pack --features sycl` without --accel still yields the CPU-only
// artifact.
bool add_library_sources(const std::string& root, bool vulkan_lane,
                         bool sycl_lane, bool cuda_lane) {
    for (const auto& path : files_with_extension(join(root, "src/core"), ".cpp"))
        mcpp::source(path.c_str());
    mcpp::source(join(root, "src/init.cpp").c_str());
    for (const auto& path : files_with_extension(join(root, "src/backend/cpu"), ".cpp"))
        mcpp::source(path.c_str());

    if (vulkan_lane) {
        mcpp::source(join(root, "src/init_vulkan.cpp").c_str());
        for (const auto& path : files_with_extension(join(root, "src/backend/vulkan"), ".cpp"))
            mcpp::source(path.c_str());
    }

    if (sycl_lane) {
        mcpp::source(join(root, "src/init_sycl.cpp").c_str());
        for (const auto& path : files_with_extension(join(root, "src/backend/sycl/host"), ".cpp"))
            mcpp::source(path.c_str());
        // sycl_island.h sits beside host/ and device/; both include it by name.
        mcpp::include_dir(join(root, "src/backend/sycl").c_str());
    }

    if (cuda_lane) {
        // Host driver; the .cu device units come from [build] sources'
        // accel-constrained glob, compiled by rules-cuda below.
        mcpp::source(join(root, "src/init_cuda.cpp").c_str());
    }
    return true;
}

// ── 运行期 shader 查找表 ─────────────────────────────────────────────────
//
// mcpp.rules.spirv 为每个 shader 生成一个具名访问器
// （`tensorvia::shaders::add::add_float32_comp()`）: 它的调用方在编译期就知道
// 自己要哪个 shader。这个库不是——pipeline 由 (OpType, DataType) 在运行期决定，
// 337 个 shader 不可能逐个写死成一串 if。所以「key → 字节」这张表由这里生成。
//
// 走的是规则自己的那套命名: 同一棵目录树、base_dir 之下的目录段作命名空间、
// `<stem>_<stage>` 作标识符。规则改了命名而这里没跟上，结果是这里生成的访问器
// 在编译期找不到符号——而不是以前那种构建通过、运行期才 throw 的失败。
struct shader_payload {
    std::string key;       // "add_float32"，即 make_pipeline_key() 的产物
    std::string accessor;  // tensorvia::shaders::add::add_float32_comp
};

std::vector<shader_payload> shader_payloads(const std::string& base_dir) {
    std::vector<shader_payload> out;
    std::error_code ec;
    if (!std::filesystem::is_directory(base_dir, ec)) return out;
    for (const auto& entry : std::filesystem::recursive_directory_iterator(base_dir, ec)) {
        if (!entry.is_regular_file() || entry.path().extension() != ".comp") continue;
        const auto rel = std::filesystem::relative(entry.path(), base_dir, ec);
        if (ec || rel.empty()) continue;

        std::string accessor = "tensorvia::shaders";
        for (const auto& seg : rel.parent_path()) accessor += "::" + seg.string();
        const std::string stem = rel.stem().string();
        accessor += "::" + stem + "_comp";
        out.push_back({stem, accessor});
    }
    std::sort(out.begin(), out.end(),
              [](const shader_payload& a, const shader_payload& b) { return a.key < b.key; });
    return out;
}

// 写 spv_registry.cpp。头文件是手写的（include/ 下），只有这张表是生成的：
// 表随 shader 树变化，接口不变。
bool write_spv_registry(const std::string& path,
                        const std::vector<shader_payload>& payloads) {
    for (std::size_t i = 1; i < payloads.size(); ++i) {
        if (payloads[i].key != payloads[i - 1].key) continue;
        std::cerr << "tensorvia: two shaders share the key \"" << payloads[i].key
                  << "\"; the runtime lookup is keyed on the file stem, so one of them "
                     "would be unreachable\n";
        return false;
    }

    std::string cpp;
    cpp += "// Generated by build.mcpp from shader/**/*.comp. Do not edit.\n";
    cpp += "#include <cstddef>\n"
           "#include <cstdint>\n"
           "#include <stdexcept>\n"
           "#include <string>\n"
           "#include <string_view>\n"
           "#include <unordered_map>\n\n";
    cpp += "import tensorvia.shaders;\n\n";
    cpp += "#include \"tensorvia/backend/vulkan/spv_registry.hpp\"\n\n";
    cpp += "namespace vkspv {\nnamespace {\n\n";
    cpp += "using payload = tensorvia::shaders::payload;\n\n";
    cpp += "// 只建一次: 访问器返回的是编译进本 TU 的静态数组，不拷贝。\n";
    cpp += "const std::unordered_map<std::string_view, payload>& table() {\n";
    cpp += "    static const std::unordered_map<std::string_view, payload> t = {\n";
    for (const auto& p : payloads)
        cpp += "        {\"" + p.key + "\", " + p.accessor + "()},\n";
    cpp += "    };\n";
    cpp += "    return t;\n";
    cpp += "}\n\n";
    cpp += "}  // namespace\n\n";
    cpp += "spv_view get_spv_code(std::string_view key) {\n";
    cpp += "    const auto& t  = table();\n";
    cpp += "    const auto  it = t.find(key);\n";
    cpp += "    if (it == t.end())\n";
    cpp += "        throw std::runtime_error(\"SPIR-V not found: \" + std::string(key));\n";
    cpp += "    return {it->second.code,\n";
    cpp += "            static_cast<std::size_t>(it->second.size_bytes) / sizeof(std::uint32_t)};\n";
    cpp += "}\n\n";
    cpp += "}  // namespace vkspv\n";

    std::error_code ec;
    std::filesystem::create_directories(std::filesystem::path(path).parent_path(), ec);
    std::ofstream out(path, std::ios::binary | std::ios::trunc);
    if (!out) {
        std::cerr << "tensorvia: cannot write " << path << '\n';
        return false;
    }
    out << cpp;
    out.close();
    if (!out) {
        std::cerr << "tensorvia: failed while writing " << path << '\n';
        return false;
    }
    return true;
}

// The CUDA line a build names, as (major, minor); nullopt when the accel
// names no version at all (`cuda+{sm_89}`). The accel is a comma-separated
// set, so the chunk carrying `cuda` is the one to read — the SYCL lane may
// legitimately name an NVIDIA AOT target beside it.
std::optional<std::pair<int, int>> cuda_line(std::string_view accel) {
    for (std::size_t pos = accel.find("cuda"); pos != std::string_view::npos;
         pos = accel.find("cuda", pos + 4)) {
        std::size_t i = pos + 4;
        std::pair<int, int> ver{};
        bool any = false;
        while (i < accel.size() &&
               std::isdigit(static_cast<unsigned char>(accel[i]))) {
            ver.first = ver.first * 10 + (accel[i++] - '0');
            any = true;
        }
        if (!any) continue;                       // `cuda+{...}`: no line
        if (i < accel.size() && accel[i] == '.') {
            ++i;
            while (i < accel.size() &&
                   std::isdigit(static_cast<unsigned char>(accel[i]))) {
                ver.second = ver.second * 10 + (accel[i++] - '0');
            }
        }
        return ver;
    }
    return std::nullopt;
}

bool run(const std::string& command, const char* what) {
    const int rc = std::system(command.c_str());
    if (rc != 0) {
        std::cerr << "mcpp build: " << what << " failed (exit " << rc << ")\n";
        return false;
    }
    return true;
}

}  // namespace

int main() {
    const std::string root = mcpp::manifest_dir();
    const std::string out  = mcpp::out_dir();

    const std::string_view accel = mcpp::accel();
    const bool cuda_in_accel   = accel.find("cuda") != std::string_view::npos;
    const bool sycl_in_accel   = accel.find("sycl") != std::string_view::npos;
    const bool vulkan_in_accel = accel.find("vulkan") != std::string_view::npos;
    const bool want_cuda   = mcpp::has_feature("cuda");
    const bool want_vulkan = mcpp::has_feature("vulkan");
    const bool want_sycl   = mcpp::has_feature("sycl");

    // A backend is only "active" when the accelerator names it; `--features
    // sycl` alone keeps building the CPU artifact (same rule as CUDA's
    // `--no-accel` path).
    //
    // Vulkan used to sit outside this axis — its shaders were compiled by a
    // script that re-implemented what the engine already does, so the lane
    // needed nothing from `accel`. mcpp.rules.spirv takes its shader set from
    // `mcpp::device_sources()`, i.e. from `[build] sources`' accel-constrained
    // globs, so the lane now needs the accelerator named like the other two —
    // and with it `[target.'cfg(accelerator = "vulkan")'.dependencies]`, which
    // is where the headers and the loader live.
    const bool cuda_lane   = cuda_in_accel && want_cuda;
    const bool sycl_lane   = sycl_in_accel && want_sycl;
    const bool vulkan_lane = vulkan_in_accel && want_vulkan;

    // `--accel` without the matching `--features` would compile device objects
    // that no host code links against. Say so instead of producing a half build.
    // A cuda chunk naming an AOT target for a SYCL build is legitimate, though:
    // `--accel "sycl, cuda12.9+{sm_89}"` asks DPC++ for the NVIDIA target.
    if (cuda_in_accel && !want_cuda && !sycl_in_accel) {
        std::cerr << "mcpp build: --accel names cuda but the `cuda` feature is off; "
                     "use --features cuda\n";
        return 1;
    }
    if (sycl_in_accel && !want_sycl) {
        std::cerr << "mcpp build: --accel names sycl but the `sycl` feature is off; "
                     "use --features sycl\n";
        return 1;
    }
    if (vulkan_in_accel && !want_vulkan) {
        std::cerr << "mcpp build: --accel names vulkan but the `vulkan` feature is off; "
                     "use --features vulkan\n";
        return 1;
    }
    // The mirror mistake, and the one a consumer makes: the feature is on but
    // the build names no accelerator, so the device units are narrowed out and
    // the artifact would silently be CPU-only. That is the documented behavior
    // of `mcpp pack --features sycl` in THIS repo (pack has no --accel), so the
    // root's program keeps taking it. A dependency's program cannot tell that
    // case from an oversight — `graph_file()` is empty for a dependency's
    // program — so there it is refused, naming the flag to add.
    if (mcpp::graph_file()[0] == '\0') {
        if (want_cuda && !cuda_in_accel) {
            std::cerr << "tensorvia: the `cuda` feature is on but this build names no "
                         "cuda accelerator; build the consumer with --accel "
                         "\"cuda13.3+{sm_89}\" (architectures are yours to choose), "
                         "or drop the feature\n";
            return 1;
        }
        if (want_sycl && !sycl_in_accel) {
            std::cerr << "tensorvia: the `sycl` feature is on but this build names no "
                         "sycl accelerator; build the consumer with --accel sycl, "
                         "or drop the feature\n";
            return 1;
        }
        if (want_vulkan && !vulkan_in_accel) {
            std::cerr << "tensorvia: the `vulkan` feature is on but this build names no "
                         "vulkan accelerator; build the consumer with --accel vulkan1.4, "
                         "or drop the feature — without it no shader is compiled and the "
                         "first pipeline lookup throws\n";
            return 1;
        }
    } else if (want_vulkan && !vulkan_in_accel) {
        // 根包这一侧沿用 sycl/cuda 的既有语义（`mcpp pack --features vulkan`
        // 没有 --accel），但结果和前两者不同：产物里没有 SPIR-V 时，第一个
        // Vulkan 算子就会抛 "SPIR-V not found"。出声，别让它悄悄发生。
        mcpp::warning("the `vulkan` feature is on but this build names no vulkan "
                      "accelerator; no shader is compiled and the artifact is CPU-only. "
                      "Name one with --accel vulkan1.4");
    }
    // rules-cuda takes its host-compiler compatibility path from the line the
    // accel names, and the toolkit this package pins is the 13.3 line: an
    // older line (or none) reaches nvcc's C23 collision with a current glibc
    // as an error that names neither the flag nor the fix. The floor below
    // must move together with the pin in
    // [target.'cfg(accelerator = "cuda")'.xlings.workspace]. The SYCL lane's
    // NVIDIA AOT target is exempt — it compiles through rules-sycl, which
    // reads the same chunk differently.
    if (cuda_lane) {
        const auto line = cuda_line(accel);
        if (!line || *line < std::pair<int, int>{13, 3}) {
            std::cerr << "tensorvia: the CUDA lane needs --accel to name cuda 13.3 or "
                         "newer — the toolkit line this package pins; write e.g. "
                         "--accel \"cuda13.3+{sm_89}\" (architectures are yours to "
                         "choose)\n";
            return 1;
        }
    }
    // The device units of the two lanes are compiled by different payload
    // compilers (nvcc vs DPC++); mcpp cannot mix them in one artifact. CMake
    // can.
    if (cuda_lane && sycl_lane) {
        std::cerr << "mcpp build: one artifact cannot use both the CUDA and SYCL lanes; "
                     "build them separately (CMake supports the combination)\n";
        return 1;
    }
    if (want_cuda && want_sycl && cuda_lane) {
        std::cerr << "mcpp build: --accel names cuda while both `cuda` and `sycl` are on; "
                     "pick one device lane\n";
        return 1;
    }

    // The wrapper's export block is generated from the hand-kept list; a
    // drifted list fails the build here, not in a consumer's.
    mcpp::rerun_if_changed(join(root, "tools/facade_exports.def").c_str());
    if (!run("python3 \"" + join(root, "tools/gen_facade.py") + "\" --check",
             "facade export check")) {
        return 1;
    }

    // One lane: the headers are the sources of truth, so the CUDA artifact
    // compiles the very same .cpp units against the very same headers the
    // module wrapper includes — there is no second form of the library.
    add_library_sources(root, vulkan_lane, sycl_lane, cuda_lane);

    // SYCL device units. The rule sees only the accel-constrained globs and
    // returns immediately when this build names no sycl accelerator, so the
    // call is harmless; gating on the lane keeps a CPU build out of the plugin.
    if (sycl_lane) {
        mcpp::rerun_if_changed_glob("src/backend/sycl/**/*.sycl");
        mcpp::rerun_if_changed_glob("src/backend/sycl/**/*.h");

        mcpp::rules::sycl::options opt;
        // The seam header lives beside host/ and device/; both include it by
        // name. Nothing here is part of the installed surface.
        opt.includes = {root + "/src/backend/sycl"};
        opt.flags    = {"-DBACKEND_SYCL"};
        if (!mcpp::rules::sycl::compile(opt)) return 1;
    }

    // Vulkan: the GLSL compute shaders are compiled by mcpp.rules.spirv — the
    // shader set comes from the accel-constrained glob in [build] sources, and
    // the compiler (glslang or glslc) is the payload the rule declares for
    // itself, so this package pulls in neither Python nor a host shader
    // compiler. What is left here is the part the rule deliberately does not
    // offer: the runtime key → SPIR-V table.
    if (vulkan_lane) {
        const std::string shader_dir = root + "/shader";
        const std::string gen_dir    = out + "/spirv";

        mcpp::link_lib("vulkan");
        // The registry is written from the shader tree at plan time, so a new
        // or removed .comp has to re-run this program. The rule's own actions
        // carry their inputs; this is for the table.
        mcpp::rerun_if_changed_glob("shader/**/*.comp");

        mcpp::rules::spirv::options opt;
        // `shader/` is both the base directory names are counted from and the
        // root a shader's `#include` resolves against.
        opt.base_dir = "shader";
        opt.includes = {"shader"};
        // 模块表面（项目的 [language] modules 决定了默认值），命名空间因此是
        // tensorvia::shaders::<目录>::<stem>_comp()。This surface is internal to
        // the build: the package does not export it, and no consumer names it.
        opt.storage = mcpp::plugins::surface::storage::header;
        // glslc from xim:shaderc, named rather than discovered: with both
        // payloads installed the rule prefers glslang, and the published
        // glslang (15.1.0) cannot compile the bfloat16 shaders.
        const char* shaderc = mcpp::xpkg_dir("shaderc");
        if (*shaderc) {
            opt.compiler = mcpp::plugins::tool::program(std::string(shaderc) + "/bin/glslc");
        } else {
            mcpp::warning("xim:shaderc is not installed, so the shader compiler "
                          "falls back to whatever the rule finds; the published "
                          "xim:glslang (15.1.0) cannot compile this tree's bfloat16 "
                          "shaders. The manifest declares \"xim:shaderc\" for exactly this");
        }
        if (!mcpp::rules::spirv::compile(opt)) return 1;

        const std::string registry = gen_dir + "/spv_registry.cpp";
        if (!write_spv_registry(registry, shader_payloads(shader_dir))) return 1;
        mcpp::generated(registry.c_str());
    }

    // CUDA device units. They include the headers and the typed launch
    // contract, so the host driver and the kernel share one translation
    // unit; nvcc only needs C++20 and the include roots.
    if (want_cuda) {
        mcpp::rules::cuda::options opt;
        opt.includes = {root + "/include", root + "/src/backend/cuda"};
        opt.flags    = {"-std=c++20", "-DBACKEND_CUDA"};
        if (!mcpp::rules::cuda::compile(opt)) return 1;
    }
    return 0;
}
